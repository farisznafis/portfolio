# Optional. Only required by the Supabase check/seed utility scripts or when
# referencing media hosted in Supabase Storage. The website runs without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional. Serve gallery files from the bucket instead of public/media, e.g.
# https://<ref>.supabase.co/storage/v1/object/public/portfolio-media
NEXT_PUBLIC_GALLERY_MEDIA_URL=
